{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@m-visioning/core/*": ["../core/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../core" }
  ]
}
