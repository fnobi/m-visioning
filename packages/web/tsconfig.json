{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2015",
    "lib": [
      "esnext",
      "dom"
    ],
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "rootDirs": [
      "./src"
    ],
    "forceConsistentCasingInFileNames": false,
    "noImplicitReturns": true,
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@m-visioning/core/*": [
        "../core/src/*"
      ]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsxImportSource": "@emotion/react",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "next-env.d.ts",
    "src/**/*",
    "typings/**/*.d.ts",
    ".next/types/**/*.ts",
    "../core/src/schema/CommonPermission.ts",
    "../core/src/util/math-util.ts",
    "../core/src/util/form-validator.ts",
    "../core/src/util/FormOrganizer.ts",
    "../core/src/util/easing.ts",
    "../core/src/util/array-util.ts",
    "../core/src/util/string-util.ts",
    "../core/src/util/promise-util.ts",
    "../core/src/schema/MyPageProperty.ts",
    "../core/src/util/DataStoreAgent.ts"
  ]
}