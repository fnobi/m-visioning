{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@m-visioning/core/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
